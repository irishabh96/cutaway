{
  "name": "cutaway",
  "version": "0.1.0",
  "private": true,
  "description": "See inside the systems you build. Interactive isometric cutaways for AI coding agents.",
  "license": "MIT",
  "homepage": "https://cutaway.phasr.sh",
  "repository": { "type": "git", "url": "https://github.com/irishabh96/cutaway.git" },
  "bugs": "https://github.com/irishabh96/cutaway/issues",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "build:kit": "node scripts/build-kit.mjs",
    "build": "node scripts/build-examples.mjs && node scripts/build-site.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "build:site": "node scripts/build-site.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify-examples.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "posters": "node scripts/create-posters.mjs",
    "record": "node scripts/record-video.mjs",
    "record:all": "node scripts/record-video.mjs --all"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.15.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typescript": "5.9.3"
  }
